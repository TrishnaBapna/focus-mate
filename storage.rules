rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidFileSize() {
      // 25 MB max file size limit per upload
      return request.resource.size < 25 * 1024 * 1024;
    }

    function isValidMediaType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('application/json')
        || request.resource.contentType.matches('application/pdf');
    }

    // Authenticated, user-scoped Storage paths: users/{userId}/**
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidFileSize()
        && isValidMediaType();
      allow delete: if isOwner(userId);
    }
  }
}
