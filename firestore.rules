rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // USER DATA
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // 1. Assessments: Validated creation, strictly IMMUTABLE (cannot update)
      match /assessments/{assessmentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['topic', 'score', 'totalQuestions', 'accuracy'])
          && request.resource.data.topic is string
          && request.resource.data.topic.size() > 0
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.totalQuestions is number
          && request.resource.data.totalQuestions > 0
          && request.resource.data.accuracy is number
          && request.resource.data.accuracy >= 0
          && request.resource.data.accuracy <= 1;
        allow update, delete: if false;
      }

      // 2. Focus Sessions: Validated focus sessions
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['durationSeconds', 'mode', 'subjectId'])
          && request.resource.data.keys().hasOnly(['durationSeconds', 'mode', 'subjectId', 'subjectName', 'subjectEmoji', 'topic', 'goal', 'strict', 'leaves', 'awaySeconds', 'completedAt'])
          && request.resource.data.durationSeconds is number
          && request.resource.data.durationSeconds >= 0
          && request.resource.data.durationSeconds <= 86400
          && request.resource.data.mode in ['timer', 'stopwatch', 'pomodoro'];
        // Updates only permitted for idempotent retries: all content and metrics must remain identical, and unexpected fields are prohibited
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['durationSeconds', 'mode', 'subjectId', 'subjectName', 'subjectEmoji', 'topic', 'goal', 'strict', 'leaves', 'awaySeconds', 'completedAt'])
          && request.resource.data.durationSeconds == resource.data.durationSeconds
          && request.resource.data.mode == resource.data.mode
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.get('subjectName', '') == resource.data.get('subjectName', '')
          && request.resource.data.get('subjectEmoji', '') == resource.data.get('subjectEmoji', '')
          && request.resource.data.get('topic', '') == resource.data.get('topic', '')
          && request.resource.data.get('goal', '') == resource.data.get('goal', '')
          && request.resource.data.get('strict', false) == resource.data.get('strict', false)
          && request.resource.data.get('leaves', 0) == resource.data.get('leaves', 0)
          && request.resource.data.get('awaySeconds', 0) == resource.data.get('awaySeconds', 0);
        allow delete: if isOwner(userId);
      }

      // 3. Subject Goals: Validated weekly study hour targets
      match /subjectGoals/{subjectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['targetHours'])
          && request.resource.data.targetHours is number
          && request.resource.data.targetHours >= 0
          && request.resource.data.targetHours <= 168;
        allow delete: if isOwner(userId);
      }

      // 4. Other subcollections (notes, folders, subjects, tasks, exams, decks, cards, plans, reviewedTopics, media, settings):
      // Single-segment wildcard fallback that STRICTLY EXCLUDES assessments, sessions, and subjectGoals.
      // This prevents Firestore's logical OR permission model from bypassing the strict validation & immutability rules above.
      match /{collectionName}/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && !(collectionName in ['assessments', 'sessions', 'subjectGoals']);
      }
    }

    function validStats(d) {
      return d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 24
        && d.emoji is string && d.emoji.size() <= 8
        && d.level is int && d.level >= 1 && d.level <= 1000
        && d.weekSeconds is int && d.weekSeconds >= 0 && d.weekSeconds <= 604800;
    }

    // The global weekly board: anyone signed in can read, and people can only write their own line.
    match /leaderboards/{week}/entries/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'emoji', 'level', 'weekSeconds', 'updatedAt'])
        && validStats(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Groups can be opened with their code, but never listed.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Only members can see who is in a group.
      match /members/{userId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
        allow create, update: if request.auth != null && request.auth.uid == userId
          && exists(/databases/$(database)/documents/groups/$(code))
          && request.resource.data.keys().hasOnly(['nickname', 'emoji', 'level', 'weekKey', 'weekSeconds', 'updatedAt'])
          && request.resource.data.weekKey is string
          && request.resource.data.weekKey.size() == 10
          && validStats(request.resource.data);
        allow delete: if request.auth != null
          && (request.auth.uid == userId
            || get(/databases/$(database)/documents/groups/$(code)).data.ownerUid == request.auth.uid);
      }
    }
  }
}
