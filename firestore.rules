rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public profile: nickname + weekly total only
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Makes nicknames unique
    match /nicknames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Friend requests; an accepted request is the friendship
    match /friendRequests/{id} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.members == [request.resource.data.from, request.resource.data.to]
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.members == resource.data.members;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members;
    }
  }
}