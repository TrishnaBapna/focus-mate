rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. User-specific private data (tasks, sessions, settings, notes, study, media, achievements, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Public profiles for social leaderboard & friend search
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 3. Unique nickname registry (used to claim/release usernames)
    match /nicknames/{nickname} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 4. Friend requests and friendships
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.from
        && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
  }
}
